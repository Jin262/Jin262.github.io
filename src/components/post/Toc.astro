---
// 이 글의 목차: 본문 h2·h3로 만든다. 현재 절 표시는 레이아웃의 스크립트가 맡는다(data-toc-link).
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
	// side는 PC 오른쪽 칸, compact는 좁은 화면의 목차다.
	variant?: 'side' | 'compact';
	groupByTopic?: boolean;
}

const { headings, variant = 'side', groupByTopic = false } = Astro.props;
const topics: { heading: MarkdownHeading; entries: MarkdownHeading[] }[] = [];
if (groupByTopic) {
	for (const heading of headings) {
		if (heading.depth === 2) topics.push({ heading, entries: [] });
		else topics.at(-1)?.entries.push(heading);
	}
}
---

<nav class:list={['toc', variant]} aria-label="이 글의 목차">
	<p class="eyebrow">이 글의 목차</p>
	<ol>
		{
			groupByTopic ? topics.map(({ heading, entries }) => (
				<li>
					<details class="toc-topic">
						<summary data-toc-link={heading.slug}>{heading.text}</summary>
						<ol>
							{entries.map((entry) => (
								<li>
									<a href={`#${entry.slug}`} class:list={[`depth-${entry.depth - 1}`]} data-toc-link={entry.slug}>
										{entry.text}
									</a>
								</li>
							))}
						</ol>
					</details>
				</li>
			)) : headings.map((h) => (
				<li>
					<a href={`#${h.slug}`} class:list={[`depth-${h.depth}`]} data-toc-link={h.slug}>
						{h.text}
					</a>
				</li>
			))
		}
	</ol>
</nav>

<style>
	.eyebrow {
		margin: 0 0 8px;
		line-height: 1.5;
	}
	ol {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: block;
		padding: 4px 0 4px 12px;
		border-left: 2px solid var(--c-divider);
		font-size: 13px;
		line-height: 1.5;
		color: var(--c-text-muted);
		text-decoration: none;
	}
	a.depth-3 {
		padding-left: 24px;
		font-size: 12px;
	}
	a:hover {
		color: var(--c-text-strong);
	}
	.compact ol {
		gap: 0;
		padding: 0 16px 12px;
	}
	.compact a {
		padding: 10px 0 10px 12px;
		font-size: 15px;
		line-height: 1.45;
		color: var(--c-text-secondary);
	}
	.compact a.depth-3 {
		padding-left: 24px;
		font-size: 14px;
	}
	.compact .eyebrow {
		margin: 16px 16px 4px;
	}
	.toc-topic > summary {
		width: fit-content;
		padding: 4px 0 4px 12px;
		border-left: 2px solid var(--c-divider);
		color: var(--c-text-muted);
		cursor: pointer;
		list-style: none;
	}
	.toc-topic > summary::-webkit-details-marker {
		display: none;
	}
	.toc-topic > ol {
		padding: 0 0 4px 8px;
	}
	.toc-topic a:not(.active),
	.toc-topic > summary {
		font-size: 12px;
		line-height: 1.5;
	}
	:is(a, .toc-topic > summary) {
		position: relative;
		transition: color 180ms ease-out, font-size 180ms ease-out;
	}
	:is(a, .toc-topic > summary)::before {
		position: absolute;
		inset-block: 0;
		left: -2px;
		width: 3px;
		border-radius: 2px;
		background: var(--c-accent);
		content: '';
		pointer-events: none;
		opacity: 0;
		transform: scaleY(0.5);
		transition: opacity 160ms ease-out, transform 180ms ease-out;
	}
	:is(a, .toc-topic > summary).active,
	.toc-topic:not([open]):has(a.active) > summary {
		border-left-color: var(--c-divider);
		color: var(--c-text-strong);
		font-size: 15px;
		font-weight: 600;
	}
	:is(a, .toc-topic > summary).active::before,
	.toc-topic:not([open]):has(a.active) > summary::before {
		opacity: 1;
		transform: scaleY(1);
	}
	@media (prefers-reduced-motion: reduce) {
		:is(a, .toc-topic > summary),
		:is(a, .toc-topic > summary)::before {
			transition: none;
		}
	}
</style>
